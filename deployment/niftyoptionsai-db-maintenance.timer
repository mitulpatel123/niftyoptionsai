[Unit]
Description=Nifty Options AI Database Maintenance Timer
Documentation=https://github.com/yourusername/niftyoptionsai

[Timer]
# FIX #8: Schedule daily database maintenance at 16:00 IST (after market close + feature build)
# IST = UTC+5:30, since the server is in IST, we just use 16:00:00
OnCalendar=*-*-* 16:00:00
Persistent=true
Unit=niftyoptionsai-db-maintenance.service

[Install]
WantedBy=timers.target
