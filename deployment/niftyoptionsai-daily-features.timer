[Unit]
Description=Nifty Options AI Daily Feature Build Timer
Documentation=https://github.com/yourusername/niftyoptionsai

[Timer]
# FIX #6: Schedule daily feature builds at 15:35 IST (market close + 5 min buffer)
# This runs after market hours to ensure all data is available
# IST = UTC+5:30, so 15:35 IST = 10:05 UTC
OnCalendar=*-*-* 10:05:00
Persistent=true
Unit=niftyoptionsai-daily-features.service

[Install]
WantedBy=timers.target
