[Unit]
Description=Nifty Options AI Live Predictor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=niftyai
WorkingDirectory=/opt/niftyoptionsai
EnvironmentFile=/opt/niftyoptionsai/.env
# We run it in continuous mode, tracking BANKNIFTY by default. 
# Feel free to change this to NIFTY or both in a separate process.
ExecStart=/opt/niftyoptionsai/.venv/bin/python /opt/niftyoptionsai/scripts/live_predictor.py --symbol BANKNIFTY --continuous
Restart=always
RestartSec=10
StandardOutput=append:/opt/niftyoptionsai/logs/live-predictor.log
StandardError=append:/opt/niftyoptionsai/logs/live-predictor.err.log

[Install]
WantedBy=multi-user.target
